  const favoriteGenre = Object.entries(genreCount).sort((a, b) => b[1] - a[1])[0];
  const favoriteGenreName = favoriteGenre ? favoriteGenre[0].charAt(0).toUpperCase() + favoriteGenre[0].slice(1) : 'N/A';

